# TALA — Supabase configuration
#
# Kopyahin ang file na ito bilang ".env.local" (na naka-ignore na sa git),
# tapos palitan ng values mula sa iyong Supabase dashboard:
#   Project Settings -> API
#
# Para sa dev/prod separation: gumawa ng HIWALAY na Supabase project para sa
# development, at ilagay ang mga value nito dito sa iyong lokal na .env.local.
# Sa production build, gamitin ang prod project values.

# Ang project ref (yung part bago ang ".supabase.co" sa iyong project URL)
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Ang publishable (anon) key — ligtas ito sa client, hindi ito ang secret key
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
